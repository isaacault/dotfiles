# Claude Code session artifacts (worktrees, local settings) — never part of the dotfiles.
# Anchored to the repo root: a bare `.claude/` also matched the claude package's
# own claude/.claude/ directory and hid any new file added there.
/.claude/

# Fetched by scripts/fetch-plugins.sh, never tracked
tmux/.config/tmux/plugins/
# Built by scripts/build-swift-tools.sh from the .swift sources next to them
aerospace/.config/aerospace/cheatsheet
sketchybar/.config/sketchybar/pomodoro/pomodoro-panel
# Machine-local state and overrides
*.local
*.work
