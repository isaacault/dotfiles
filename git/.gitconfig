[user]
	name = Isaac Ault
	email = isaac.ault@gmail.com

[init]
	defaultBranch = main
[pull]
	rebase = true

# Machine-local git config (work identity, credential helpers, host overrides).
# ~/.gitconfig.local is untracked and never enters this repo. It is included
# BEFORE the personal includeIf below so that the personal identity wins for
# isaacault/* repos even on a work machine.
[include]
	path = ~/.gitconfig.local

# Personal GitHub repos always commit under the personal identity, even on
# work machines: covers this dotfiles repo and every isaacault/* clone.
# (git >= 2.36; older gits ignore the condition harmlessly.)
[includeIf "hasconfig:remote.*.url:git@github.com:isaacault/**"]
	path = ~/.config/git/personal
[includeIf "hasconfig:remote.*.url:https://github.com/isaacault/**"]
	path = ~/.config/git/personal
